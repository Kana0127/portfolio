<% content_for :title, t(".page_title") %>

<main class="archive-page">

  <header class="archive-header">

    <h1 class="archive-heading">
      <%= t(".heading") %>
    </h1>

    <p class="archive-tagline">
      <%= t(".tagline") %>
    </p>

  </header>


  <% if @total_count.zero? %>

    <%# ==============================
        空状態
    ============================== %>

    <section class="archive-empty">

      <div class="archive-empty-icon" aria-hidden="true">
        🌱
      </div>

      <p class="archive-empty-text">
        <%= t(".empty.line1") %>
        <br>
        <%= t(".empty.line2") %>
      </p>

      <%= link_to t(".actions.back_to_reviews"),
            reviews_path,
            class: "archive-btn archive-btn--secondary" %>

    </section>


  <% else %>

    <% @month_groups.each do |group| %>

      <% month = group[:target_month] %>


      <section
        class="archive-month"
        aria-labelledby="archive-month-<%= month.strftime('%Y%m') %>"
      >

        <h2
          id="archive-month-<%= month.strftime('%Y%m') %>"
          class="archive-month-heading"
        >

          <span class="archive-month-icon" aria-hidden="true">
            📅
          </span>

          <%= l(month, format: :year_month) %>

        </h2>


        <ul class="archive-list">


          <%# ==================================================
              月次レビュー
          =================================================== %>

          <% if group[:monthly_reviews].any? %>

            <li class="archive-card archive-card--monthly">

              <div class="archive-card-head">

                <span class="archive-badge archive-badge--monthly">
                  <%= t(".badges.monthly") %>
                </span>

                <p class="archive-card-title">
                  <%= t(
                        ".monthly.title",
                        month: l(month, format: :month_only)
                      ) %>
                </p>

              </div>


              <ul class="archive-card-items">

                <% group[:monthly_reviews].each do |review| %>

                  <% mg = review.monthly_goal %>

                  <li class="archive-card-item">

                    <p class="archive-card-item-title">
                      <%= mg.title %>
                    </p>


                    <dl class="archive-card-summary">

                      <div class="archive-card-summary-item">

                        <dt>
                          <%= t(".summary.achievement_rate") %>
                        </dt>

                        <dd>
                          <strong>
                            <%= review.achievement_rate %>%
                          </strong>
                        </dd>

                      </div>


                      <div class="archive-card-summary-item">

                        <dt>
                          <%= t(".monthly.good_point") %>
                        </dt>

                        <dd>
                          <%= truncate(review.good_point, length: 60) %>
                        </dd>

                      </div>


                      <div class="archive-card-summary-item">

                        <dt>
                          <%= t(".monthly.improvement_point") %>
                        </dt>

                        <dd>
                          <%= truncate(review.improvement_point, length: 60) %>
                        </dd>

                      </div>


                      <% if review.memo.present? %>

                        <div class="archive-card-summary-item">

                          <dt>
                            <%= t(".summary.memo") %>
                          </dt>

                          <dd>
                            <%= truncate(review.memo, length: 60) %>
                          </dd>

                        </div>

                      <% end %>

                    </dl>


                    <%= link_to t(".actions.details"),
                          monthly_goal_monthly_review_path(mg),
                          class: "archive-card-link" %>

                  </li>

                <% end %>

              </ul>

            </li>

          <% end %>


          <%# ==================================================
              週次レビュー
          =================================================== %>

          <% group[:weekly_groups].each do |wg| %>

            <li class="archive-card archive-card--weekly">

              <div class="archive-card-head">

                <span class="archive-badge archive-badge--weekly">
                  <%= t(".badges.weekly") %>
                </span>

                <p class="archive-card-title">

                  <%= t(
                        ".weekly.title",
                        month: l(month, format: :month_only),
                        week_number: wg[:week_number]
                      ) %>

                </p>

              </div>


              <p class="archive-card-period">

                <%= t(
                      ".weekly.period",
                      start_date: l(
                        wg[:start_date],
                        format: :month_day
                      ),
                      end_date: l(
                        wg[:start_date] + 6.days,
                        format: :month_day
                      )
                    ) %>

              </p>


              <ul class="archive-card-items">

                <% wg[:reviews].each do |review| %>

                  <% weekly = review.weekly_goal %>

                  <li class="archive-card-item">

                    <p class="archive-card-item-title">
                      <%= weekly.title %>
                    </p>


                    <dl class="archive-card-summary">

                      <div class="archive-card-summary-item">

                        <dt>
                          <%= t(".summary.achievement_rate") %>
                        </dt>

                        <dd>
                          <strong>
                            <%= review.achievement_rate %>%
                          </strong>
                        </dd>

                      </div>


                      <div class="archive-card-summary-item">

                        <dt>
                          <%= t(".weekly.good_point") %>
                        </dt>

                        <dd>
                          <%= truncate(review.good_point, length: 50) %>
                        </dd>

                      </div>


                      <div class="archive-card-summary-item">

                        <dt>
                          <%= t(".weekly.improvement_point") %>
                        </dt>

                        <dd>
                          <%= truncate(review.improvement_point, length: 50) %>
                        </dd>

                      </div>


                      <% if review.memo.present? %>

                        <div class="archive-card-summary-item">

                          <dt>
                            <%= t(".summary.memo") %>
                          </dt>

                          <dd>
                            <%= truncate(review.memo, length: 50) %>
                          </dd>

                        </div>

                      <% end %>

                    </dl>


                    <%= link_to t(".actions.details"),
                          weekly_goal_weekly_review_path(weekly),
                          class: "archive-card-link" %>

                  </li>

                <% end %>

              </ul>

            </li>

          <% end %>

        </ul>

      </section>

    <% end %>

  <% end %>


  <p class="archive-back-link">

    <%= link_to t(".actions.back_to_reviews"),
          reviews_path,
          class: "archive-btn archive-btn--secondary archive-btn--full" %>

  </p>

</main>