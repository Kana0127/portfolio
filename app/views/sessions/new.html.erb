<% content_for :title, "ログイン | Monthly Step" %>

<div class="login-page">
  <section class="login-card" aria-labelledby="login-heading">

    <p class="top-app-name">Monthly Step</p>

    <header class="login-header">
      <h1 id="login-heading" class="login-heading">
        ログイン
      </h1>

      <p class="login-lead">
        アカウント情報を入力してください。
      </p>
    </header>

    <%= form_with url: login_path, local: true, class: "ms-form" do |f| %>

      <div class="ms-form-group">
        <%= f.label :email,
                    "メールアドレス",
                    class: "ms-form-label" %>

        <%= f.email_field :email,
              class: "ms-form-input",
              placeholder: "your@email.com",
              autocomplete: "email" %>
      </div>

      <div class="ms-form-group">
        <%= f.label :password,
                    "パスワード",
                    class: "ms-form-label" %>

        <%= f.password_field :password,
              class: "ms-form-input",
              placeholder: "••••••••",
              autocomplete: "current-password" %>
      </div>

      <%= f.submit "ログイン",
                   class: "btn-primary" %>

    <% end %>

    <p class="ms-back-link">
      アカウントをお持ちでない方は
      <%= link_to "新規会員登録",
                  new_user_path,
                  class: "ms-back-link-anchor" %>
    </p>

    <p class="ms-back-link">
      <%= link_to "TOPに戻る",
                  root_path,
                  class: "ms-back-link-anchor" %>
    </p>

  </section>
</div>