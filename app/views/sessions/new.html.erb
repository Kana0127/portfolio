<% content_for :title, t(".page_title") %>

<div class="login-page">
  <section class="login-card" aria-labelledby="login-heading">

    <p class="top-app-name"><%= t(".app_name") %></p>

    <header class="login-header">
      <h1 id="login-heading" class="login-heading">
        <%= t(".heading") %>
      </h1>

      <p class="login-lead">
        <%= t(".lead") %>
      </p>
    </header>

    <%= form_with url: login_path, local: true, class: "ms-form" do |f| %>

      <div class="ms-form-group">
        <%= f.label :email,
                    t(".email.label"),
                    class: "ms-form-label" %>

        <%= f.email_field :email,
              class: "ms-form-input",
              placeholder: t(".email.placeholder"),
              autocomplete: "email" %>
      </div>

      <div class="ms-form-group">
        <%= f.label :password,
                    t(".password.label"),
                    class: "ms-form-label" %>

        <%= f.password_field :password,
              class: "ms-form-input",
              placeholder: "••••••••",
              autocomplete: "current-password" %>
      </div>

      <%= f.submit t(".submit"),
                   class: "btn-primary" %>

    <% end %>

    <p class="ms-back-link">
      <%= t(".signup_prompt") %>
      <%= link_to t(".signup_link"),
                  new_user_path,
                  class: "ms-back-link-anchor" %>
    </p>

    <p class="ms-back-link">
      <%= link_to t("common.back_to_top"),
                  root_path,
                  class: "ms-back-link-anchor" %>
    </p>

  </section>
</div>
