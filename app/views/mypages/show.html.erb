<% content_for :title, t(".page_title") %>

<main class="mypage">
  <div class="ms-container">

    <header class="mypage-header">

      <p class="mypage-greeting">
        <span class="mypage-greeting-name">
          <%= t(".username", name: current_user.name) %>
        </span>

        <%= t(".greeting") %>
      </p>

      <p class="mypage-greeting-lead">
        <%= t(".greeting_lead") %>
      </p>

    </header>


    <% if @cards.empty? %>

      <%# 今週の週目標が1件もない場合 %>

      <section class="mypage-card mypage-card--empty">

        <p class="mypage-empty-text">
          <%= t(".weekly.empty") %>
        </p>

        <%# TODO: 単体週目標も考慮した作成導線に変更する %>
        <%= link_to t(".weekly.add"),
              new_monthly_goal_path(target_month: "this"),
              class: "mypage-btn mypage-btn--primary" %>

      </section>


    <% else %>

      <% @cards.each_with_index do |card, idx| %>

        <% weekly = card[:weekly_goal] %>
        <% monthly = card[:monthly_goal] %>
        <% roadmap_goal = card[:roadmap_goal] %>
        <% today_record = card[:today_record] %>
        <% origin = card[:origin] %>


        <% if idx > 0 %>
          <hr class="mypage-divider" aria-hidden="true">
        <% end %>


        <%# ==================================================
            今週の目標
        =================================================== %>

        <section
          class="mypage-card mypage-card--weekly"
          aria-labelledby="mypage-weekly-title-<%= weekly.id %>"
        >

          <div class="mypage-card-head">

            <p class="mypage-card-label">
              <%= t(".weekly.label") %>
            </p>


            <%# 月目標に紐づく週目標などで week_number がある場合のみ表示 %>

            <% if weekly.week_number.present? %>

              <span class="mypage-card-week">
                <%= t(
                      ".weekly.week_number",
                      number: weekly.week_number
                    ) %>
              </span>

            <% end %>

          </div>


          <%# ==================================================
              週目標の由来・親目標
          =================================================== %>

          <div class="mypage-card-meta">

            <span class="mypage-chip mypage-chip--kind">
              <%= t(".origin.#{origin}") %>
            </span>


            <% if weekly.category.present? %>

              <span class="mypage-chip mypage-chip--category">
                <%= weekly.category.name %>
              </span>

            <% end %>

          </div>


          <% if roadmap_goal.present? %>

            <p class="mypage-card-parent">
              <span class="mypage-card-parent-label">
                <%= t(".roadmap.label") %>
              </span>

              <%= roadmap_goal.title %>
            </p>

          <% end %>


          <% if monthly.present? %>

            <p class="mypage-card-parent">
              <span class="mypage-card-parent-label">
                <%= t(".monthly.label") %>
              </span>

              <%= monthly.title %>
            </p>

          <% end %>


          <%# ==================================================
              週目標本体
          =================================================== %>

          <p
            id="mypage-weekly-title-<%= weekly.id %>"
            class="mypage-card-title"
          >
            <%= weekly.title %>
          </p>


          <p class="mypage-card-sub">
            <%= t(
                  ".weekly.date_range",
                  start_date: l(weekly.start_date, format: :month_day),
                  end_date: l(weekly.start_date + 6.days, format: :month_day)
                ) %>
          </p>


          <%# ==================================================
              今日の記録
          =================================================== %>

          <div class="mypage-card-record">

            <% if today_record %>

              <p class="mypage-record-done mypage-record-done--<%= today_record.status %>">

                <span class="mypage-record-symbol">
                  <%= today_record.status_symbol %>
                </span>

                <span class="mypage-record-label">
                  <%= today_record.status_label %>
                </span>

                <span class="mypage-record-msg">
                  <%= t(".record.recorded_message") %>
                </span>

              </p>


              <% if today_record.memo.present? %>

                <div class="mypage-record-memo">

                  <p class="mypage-record-memo__label">
                    <%= t(".record.memo_label") %>
                  </p>

                  <p class="mypage-record-memo__text">
                    <%= today_record.memo %>
                  </p>

                </div>

              <% end %>


              <button
                type="button"
                class="mypage-btn mypage-btn--disabled"
                disabled
              >
                <%= t(".record.recorded") %>
              </button>


            <% else %>

              <p class="mypage-record-prompt">
                <%= t(".record.prompt") %>
              </p>

              <%= link_to t(".record.create"),
                    new_weekly_goal_daily_record_path(weekly),
                    class: "mypage-btn mypage-btn--primary" %>

            <% end %>

          </div>

        </section>

      <% end %>

    <% end %>

  </div>
</main>