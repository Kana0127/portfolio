<% content_for :title, t(".page_title") %>

<main class="top-page">
  <section class="top-card" aria-labelledby="top-heading">

    <p class="top-app-name">
      Monthly Step
    </p>

    <header class="top-header">

      <h1 id="top-heading" class="top-heading">
        <%= t(".heading") %>
      </h1>

      <p class="top-lead">
        <%= t(".lead_first") %><br>
        <%= t(".lead_second") %>
      </p>

    </header>

    <div class="top-actions">

      <%= link_to t(".start"),
            new_user_path,
            class: "btn-primary",
            role: "button" %>

      <%= link_to t(".login"),
            login_path,
            class: "btn-primary btn--secondary",
            role: "button" %>

    </div>

  </section>
</main>