<% content_for :title, t(".page_title") %>

<main class="goal-new-page">
  <header class="goal-new-header">
    <%= link_to "←", roadmap_goal_path(@roadmap_goal), class: "goal-new-back", "aria-label": t(".back_aria") %>
    <h1 class="goal-new-heading"><%= t(".heading") %></h1>
  </header>

  <section class="goal-new-card">
    <%= render "form",
          roadmap_goal: @roadmap_goal,
          categories: @categories,
          url: roadmap_goal_path(@roadmap_goal),
          submit_label: t(".submit") %>
  </section>
</main>
