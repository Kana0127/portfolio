<% content_for :title, t(".page_title") %>

<main class="roadmap-page">
  <header class="roadmap-header">
    <%= link_to "←", monthly_goals_path, class: "roadmap-back", "aria-label": t(".back_aria") %>
    <h1 class="roadmap-heading"><%= t(".heading") %></h1>
  </header>

  <% if @roadmap_goals.empty? %>
    <p class="goals-empty"><%= t(".empty_line1") %><br><%= t(".empty_line2") %></p>
  <% else %>
    <section class="roadmap-summary">
      <% @roadmap_goals.each do |roadmap| %>
        <article class="roadmap-summary-card">
          <div class="roadmap-summary-head">
            <span class="roadmap-summary-label">
              <span class="roadmap-summary-icon" aria-hidden="true">📖</span>
              <%= t(".label") %>
            </span>
            <span class="roadmap-summary-badge"><%= t(".badge") %></span>
          </div>
          <p class="roadmap-summary-title"><%= roadmap.title %></p>
          <p class="roadmap-summary-meta">
            <%= t(".period",
                  start_month: l(roadmap.start_month, format: :year_month),
                  target_month: l(roadmap.target_month, format: :year_month)) %>
          </p>
          <%= link_to t(".show_link"), roadmap_goal_path(roadmap), class: "roadmap-summary-link" %>
        </article>
      <% end %>
    </section>
  <% end %>
</main>
