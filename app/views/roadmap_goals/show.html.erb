<% content_for :title, t(".page_title") %>

<main class="roadmap-page">

  <header class="roadmap-header">

    <%= link_to "←",
          monthly_goals_path,
          class: "roadmap-back",
          "aria-label": t(".back_aria") %>

    <h1 class="roadmap-heading">
      <%= t(".heading") %>
    </h1>

  </header>


  <section class="roadmap-detail-card">

    <div class="roadmap-detail-head">
      <span class="roadmap-summary-badge">
        <%= @roadmap_goal.status_label %>
      </span>
    </div>


    <h2 class="roadmap-detail-title">
      <%= @roadmap_goal.title %>
    </h2>


    <p class="roadmap-detail-period">
      <%= t(
            ".period",
            start_month: l(@roadmap_goal.start_month, format: :year_month),
            target_month: l(@roadmap_goal.target_month, format: :year_month)
          ) %>
    </p>


    <% if @roadmap_goal.reason.present? %>

      <div class="roadmap-detail-reason">

        <span
          class="roadmap-detail-reason-icon"
          aria-hidden="true"
        >
          💬
        </span>

        <div class="roadmap-detail-reason-text">
          <%= simple_format(@roadmap_goal.reason) %>
        </div>

      </div>

    <% end %>


    <dl class="roadmap-detail-list">

      <div class="roadmap-detail-item">
        <dt><%= t(".category") %></dt>
        <dd><%= @roadmap_goal.category.name %></dd>
      </div>


      <div class="roadmap-detail-item">
        <dt><%= t(".status") %></dt>
        <dd><%= @roadmap_goal.status_label %></dd>
      </div>


      <div class="roadmap-detail-item">
        <dt><%= t(".created_at") %></dt>

        <dd>
          <%= l(
                @roadmap_goal.created_at.to_date,
                format: :year_month_day
              ) %>
        </dd>
      </div>

    </dl>

  </section>


  <div class="roadmap-detail-actions">

    <%= link_to t(".edit"),
          edit_roadmap_goal_path(@roadmap_goal),
          class: "goals-btn goals-btn--primary roadmap-action-btn" %>


    <%= button_to t(".delete"),
          roadmap_goal_path(@roadmap_goal),
          method: :delete,
          form: {
            class: "roadmap-action-form",
            data: {
              turbo_confirm: t(".delete_confirm")
            }
          },
          class: "goals-btn goals-btn--danger roadmap-action-btn" %>

  </div>


  <p class="roadmap-back-link">

    <%= link_to t(".back_to_goals"),
          monthly_goals_path,
          class: "goals-btn goals-btn--secondary roadmap-back-btn" %>

  </p>

</main>