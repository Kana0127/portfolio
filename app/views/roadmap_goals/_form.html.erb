<%#
  ロードマップ目標フォーム（new / edit 共通）
  ローカル変数:
    roadmap_goal : 対象の RoadmapGoal（新規 or 既存）
    categories   : カテゴリ選択肢
    submit_label : 送信ボタンの文言（翻訳済みの文字列を渡す）
    url          : 送信先（任意。省略時は form_with が model から自動判定）
  new は月目標設定画面へ POST、edit は永続化済みのため PATCH で update する。
%>
<% url ||= nil %>
<% if roadmap_goal.errors.any? %>
  <div class="goal-new-error" role="alert">
    <p class="goal-new-error-title"><%= t("common.errors.title", count: roadmap_goal.errors.count) %></p>
    <ul class="goal-new-error-list">
      <% roadmap_goal.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%#
  この画面は Turbo Stream ではなく通常のページ遷移で次画面へ進むため turbo: false。
  Turbo 有効だと POST への 200 render が描画されず「ボタンが無反応」に見える。
%>
<%= form_with model: roadmap_goal, url: url, local: true,
              data: { turbo: false }, class: "goal-new-form" do |f| %>
  <div class="goal-new-form-group">
    <%= f.label :title, t("roadmap_goals.form.title.label"), class: "goal-new-form-label" %>
    <%= f.text_field :title,
          class: "goal-new-form-input",
          placeholder: t("roadmap_goals.form.title.placeholder") %>
  </div>

  <div class="goal-new-form-group">
    <%= f.label :reason, t("roadmap_goals.form.reason.label"), class: "goal-new-form-label" %>
    <%= f.text_area :reason,
          class: "goal-new-form-input goal-new-form-textarea",
          rows: 3,
          placeholder: t("roadmap_goals.form.reason.placeholder") %>
  </div>

  <div class="roadmap-form-row">
    <div class="goal-new-form-group">
      <%= f.label :start_month, t("roadmap_goals.form.start_month.label"), class: "goal-new-form-label" %>
      <%= f.month_field :start_month,
            value: roadmap_goal.start_month&.strftime("%Y-%m"),
            class: "goal-new-form-input" %>
    </div>

    <div class="goal-new-form-group">
      <%= f.label :target_month, t("roadmap_goals.form.target_month.label"), class: "goal-new-form-label" %>
      <%= f.month_field :target_month,
            value: roadmap_goal.target_month&.strftime("%Y-%m"),
            class: "goal-new-form-input" %>
    </div>
  </div>

  <div class="goal-new-form-group">
    <span class="goal-new-form-label"><%= t("roadmap_goals.form.category.label") %></span>
    <div class="goal-new-chips" role="radiogroup" aria-label="<%= t('roadmap_goals.form.category.aria_label') %>">
      <% categories.each do |category| %>
        <label class="goal-new-chip">
          <%= f.radio_button :category_id, category.id, class: "goal-new-chip-input" %>
          <span class="goal-new-chip-label"><%= category.name %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="goal-new-form-group">
    <%= f.label :status, t("roadmap_goals.form.status.label"), class: "goal-new-form-label" %>
    <%= f.select :status,
          RoadmapGoal.status_options,
          {},
          class: "goal-new-form-input goal-new-form-select" %>
  </div>

  <%= f.submit submit_label, class: "goal-new-submit" %>
<% end %>
