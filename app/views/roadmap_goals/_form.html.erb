
<%#
  ロードマップ目標フォーム（new / edit 共通）

  ローカル変数:
    roadmap_goal : 対象の RoadmapGoal（新規 or 既存）
    categories   : カテゴリ選択肢
    submit_label : 送信ボタンの文言
    url          : 送信先（任意）

  new  : 月目標設定画面へ POST
  edit : 保存済みのロードマップを PATCH で更新
%>

<% url ||= nil %>

<%# ==================================================
    エラーメッセージ
=================================================== %>

<% if roadmap_goal.errors.any? %>
  <div class="goal-new-error" role="alert">
    <p class="goal-new-error-title">
      <%= t("common.errors.title", count: roadmap_goal.errors.count) %>
    </p>

    <ul class="goal-new-error-list">
      <% roadmap_goal.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ==================================================
    フォーム
=================================================== %>

<%= form_with model: roadmap_goal,
              url: url,
              local: true,
              data: { turbo: false },
              class: "goal-new-form" do |f| %>

  <%# ==================================================
      目標タイトル
  =================================================== %>

  <div class="goal-new-form-group">
    <%= f.label :title,
          t("roadmap_goals.form.title.label"),
          class: "goal-new-form-label" %>

    <%= f.text_field :title,
          class: "goal-new-form-input",
          placeholder: t("roadmap_goals.form.title.placeholder") %>
  </div>

  <%# ==================================================
      目標を設定した理由
  =================================================== %>

  <div class="goal-new-form-group">
    <%= f.label :reason,
          t("roadmap_goals.form.reason.label"),
          class: "goal-new-form-label" %>

    <%= f.text_area :reason,
          class: "goal-new-form-input goal-new-form-textarea",
          rows: 3,
          placeholder: t("roadmap_goals.form.reason.placeholder") %>
  </div>

  <%# ==================================================
      ロードマップ期間
  =================================================== %>

  <% if roadmap_goal.new_record? %>

    <%# 新規作成：開始月と達成までの期間を選択 %>

    <div class="roadmap-form-row">

      <%# ① 開始月：今月・来月 %>

      <div class="goal-new-form-group">

        <%= label_tag :start_period,
              t("roadmap_goals.form.start_month.label"),
              class: "goal-new-form-label" %>

        <%= select_tag :start_period,
              options_for_select(
                [
                  [
                    t("roadmap_goals.form.start_month.current",
                      month: l(Date.current, format: :month_only)),
                    "this"
                  ],
                  [
                    t("roadmap_goals.form.start_month.next",
                      month: l(Date.current.next_month, format: :month_only)),
                    "next"
                  ]
                ],
                @start_period || "this"
              ),
              class: "goal-new-form-input" %>

      </div>

      <%# ② 達成までの期間：2〜6か月後 %>

      <div class="goal-new-form-group">

        <%= label_tag :duration_months,
              t("roadmap_goals.form.duration_months.label"),
              class: "goal-new-form-label" %>

        <% duration_options =
             (RoadmapGoal::MIN_DURATION_MONTHS..
              RoadmapGoal::MAX_DURATION_MONTHS).map do |months|
               [
                 t("roadmap_goals.form.duration_months.option",
                   months: months),
                 months.to_s
               ]
             end %>

        <%= select_tag :duration_months,
              options_for_select(
                duration_options,
                @duration_months || RoadmapGoal::MIN_DURATION_MONTHS.to_s
              ),
              class: "goal-new-form-input" %>

      </div>

    </div>

  <% else %>

    <%# 編集：既存の開始月・達成予定月を表示 %>

    <div class="roadmap-form-row">

      <div class="goal-new-form-group">

        <%= f.label :start_month,
              t("roadmap_goals.form.start_month.label"),
              class: "goal-new-form-label" %>

        <%= f.month_field :start_month,
              value: roadmap_goal.start_month&.strftime("%Y-%m"),
              class: "goal-new-form-input" %>

      </div>

      <div class="goal-new-form-group">

        <%= f.label :target_month,
              t("roadmap_goals.form.target_month.label"),
              class: "goal-new-form-label" %>

        <%= f.month_field :target_month,
              value: roadmap_goal.target_month&.strftime("%Y-%m"),
              class: "goal-new-form-input" %>

      </div>

    </div>

  <% end %>

  <%# ==================================================
      カテゴリー
  =================================================== %>

  <div class="goal-new-form-group">

    <span class="goal-new-form-label">
      <%= t("roadmap_goals.form.category.label") %>
    </span>

    <div class="goal-new-chips"
         role="radiogroup"
         aria-label="<%= t('roadmap_goals.form.category.aria_label') %>">

      <% categories.each do |category| %>

        <label class="goal-new-chip">

          <%= f.radio_button :category_id,
                category.id,
                class: "goal-new-chip-input" %>

          <span class="goal-new-chip-label">
            <%= category.name %>
          </span>

        </label>

      <% end %>

    </div>

  </div>

  <%# ==================================================
      ステータス
  =================================================== %>

  <div class="goal-new-form-group">

    <%= f.label :status,
          t("roadmap_goals.form.status.label"),
          class: "goal-new-form-label" %>

    <%= f.select :status,
          RoadmapGoal.status_options,
          {},
          class: "goal-new-form-input goal-new-form-select" %>

  </div>

  <%# ==================================================
      送信ボタン
  =================================================== %>

  <%= f.submit submit_label, class: "btn-primary" %>

<% end %>
