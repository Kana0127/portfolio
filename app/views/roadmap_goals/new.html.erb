<% content_for :title, t(".page_title") %>

<main class="goal-new-page">
  <header class="goal-new-header">
    <%= link_to "←", monthly_goals_path, class: "goal-new-back", "aria-label": t(".back_aria") %>
    <h1 class="goal-new-heading"><%= t(".heading") %></h1>
  </header>

  <section class="goal-new-card" aria-labelledby="roadmap-new-about">
    <div class="roadmap-note" id="roadmap-new-about">
      <p class="roadmap-note-title"><%= t(".about.title") %></p>
      <p class="roadmap-note-text">
        <%= t(".about.text") %>
      </p>
    </div>

    <%= render "form",
          roadmap_goal: @roadmap_goal,
          categories: @categories,
          url: monthly_goals_setup_roadmap_goals_path,
          submit_label: t(".submit") %>
  </section>
</main>
