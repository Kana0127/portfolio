<% content_for :title, t(".page_title") %>

<main class="record-page">

  <header class="record-header">

    <%= link_to "←",
          monthly_goals_path,
          class: "record-back",
          "aria-label": t(".back_aria") %>

    <div class="record-header-titles">

      <h1 class="record-heading">
        <%= t(".heading") %>
      </h1>

      <p class="record-lead">
        <%= t(".lead") %>
      </p>

    </div>

  </header>


  <section
    class="record-target"
    aria-labelledby="record-target-title"
  >

    <p class="record-target-label">
      ⚑ <%= t(".weekly_goal_label") %>
    </p>

    <p
      id="record-target-title"
      class="record-target-title"
    >
      <%= @weekly_goal.title %>
    </p>

    <p class="record-target-month">
      <%= t(
            ".target_period",
            month: l(
              @weekly_goal.monthly_goal.target_month,
              format: :year_month
            ),
            week_number: @weekly_goal.week_number
          ) %>
    </p>

  </section>


  <% if @daily_record.errors.any? %>

    <div class="record-error" role="alert">

      <p class="record-error-title">
        <%= t(
              ".errors.title",
              count: @daily_record.errors.count
            ) %>
      </p>

      <ul class="record-error-list">

        <% @daily_record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>


  <%= form_with model: [@weekly_goal, @daily_record],
        local: true,
        class: "record-form" do |f| %>


    <fieldset class="record-statuses-group">

      <legend class="record-section-heading">
        <%= t(".achievement_label") %>
      </legend>

      <div class="record-statuses">

        <% [
          ["perfect", "◎", t(".statuses.perfect")],
          ["good",    "○", t(".statuses.good")],
          ["bad",     "×", t(".statuses.bad")]
        ].each do |val, sym, desc| %>

          <label class="record-status">

            <%= f.radio_button :status,
                  val,
                  class: "record-status-input" %>

            <span class="record-status-card">

              <span class="record-status-symbol">
                <%= sym %>
              </span>

              <span class="record-status-desc">
                <%= sym %> <%= desc %>
              </span>

            </span>

          </label>

        <% end %>

      </div>

    </fieldset>


    <div class="record-memo-group">

      <%= f.label :memo,
            t(".memo.label"),
            class: "record-memo-label" %>

      <%= f.text_area :memo,
            class: "record-memo-input",
            rows: 4,
            placeholder: t(".memo.placeholder") %>

    </div>


    <%= f.submit t(".submit"),
          class: "record-submit" %>

  <% end %>

</main>