<% content_for :title, t(".page_title") %>

<div class="signup-page">
  <section class="signup-card" aria-labelledby="signup-heading">

    <p class="top-app-name"><%= t(".app_name") %></p>

    <header class="signup-header">
      <h1 id="signup-heading" class="signup-heading">
        <%= t(".heading") %>
      </h1>

      <p class="signup-lead">
        <%= t(".lead") %>
      </p>
    </header>

    <% if @user.errors.any? %>
      <div class="signup-error" role="alert">
        <p class="signup-error-title">
          <%= t("common.errors.title", count: @user.errors.count) %>
        </p>

        <ul class="signup-error-list">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, local: true, class: "ms-form" do |f| %>

      <div class="ms-form-group">
        <%= f.label :name,
                    t(".name.label"),
                    class: "ms-form-label" %>

        <%= f.text_field :name,
              class: "ms-form-input",
              placeholder: t(".name.placeholder"),
              autocomplete: "name" %>
      </div>

      <div class="ms-form-group">
        <%= f.label :email,
                    t(".email.label"),
                    class: "ms-form-label" %>

        <%= f.email_field :email,
              class: "ms-form-input",
              placeholder: t(".email.placeholder"),
              autocomplete: "email" %>
      </div>

      <div class="ms-form-group">
        <%= f.label :password,
                    t(".password.label"),
                    class: "ms-form-label" %>

        <%= f.password_field :password,
              class: "ms-form-input",
              placeholder: "••••••••",
              autocomplete: "new-password" %>

        <p class="ms-form-hint">
          <%= t(".password.hint") %>
        </p>
      </div>

      <div class="ms-form-group">
        <%= f.label :password_confirmation,
                    t(".password_confirmation.label"),
                    class: "ms-form-label" %>

        <%= f.password_field :password_confirmation,
              class: "ms-form-input",
              placeholder: "••••••••",
              autocomplete: "new-password" %>
      </div>

      <%= f.submit t(".submit"), class: "btn-primary" %>

    <% end %>

    <p class="ms-back-link">
      <%= link_to t("common.back_to_top"),
                  root_path,
                  class: "ms-back-link-anchor" %>
    </p>

  </section>
</div>
