<%# ============================================================
    ロードマップ目標カード

    index.html.erb から渡されるもの

    roadmap_goal
      → ロードマップ目標1件

    monthly_goals
      → このロードマップに紐づく「今月の月目標」
============================================================ %>

<div
  class="roadmap-group"
  data-controller="goal-accordion">

  <article class="roadmap-summary-card">

    <div class="roadmap-summary-main">

      <div
        class="roadmap-summary-icon"
        aria-hidden="true">
        📖
      </div>

      <div class="roadmap-summary-content">

        <span class="goals-card-chip goals-card-chip--category">
          <%= roadmap_goal.category.name %>
        </span>

        <h3 class="roadmap-summary-title">
          <%= roadmap_goal.title %>
        </h3>

        <p class="roadmap-summary-meta">

          <span>
            <%= l roadmap_goal.start_month, format: :year_month %>
            〜
            <%= l roadmap_goal.target_month, format: :year_month %>
          </span>

          <span class="roadmap-summary-remaining">
            <%= roadmap_remaining_label(roadmap_goal) %>
          </span>

        </p>

      </div>

      <div class="roadmap-summary-actions">

        <%= link_to t("common.details"),
              roadmap_goal_path(roadmap_goal),
              class: "roadmap-summary-link" %>

        <button
          type="button"
          class="roadmap-summary-toggle"
          aria-expanded="false"
          aria-label="<%= t('.show_monthly_goals', title: roadmap_goal.title) %>"
          data-goal-accordion-target="button"
          data-action="goal-accordion#toggle">

          <span
            class="roadmap-summary-toggle-icon"
            aria-hidden="true">
            ▼
          </span>

        </button>

      </div>

    </div>

  </article>


  <div
    class="roadmap-group-children"
    data-goal-accordion-target="content"
    hidden>

    <h4 class="roadmap-group-children-heading">
      <%= t(".monthly_goals_heading") %>
    </h4>

    <% if monthly_goals.empty? %>

      <p class="roadmap-group-empty">
        <%= t(".no_monthly_goals") %>
      </p>

    <% else %>

      <div class="roadmap-monthly-list">

        <% monthly_goals.each do |monthly_goal| %>

          <div class="roadmap-monthly-item">

            <div class="roadmap-monthly-item__main">

              <div
                class="roadmap-monthly-item__icon"
                aria-hidden="true">
                📅
              </div>

              <div class="roadmap-monthly-item__content">

                <% if monthly_goal.category.present? %>

                  <span class="goals-card-chip goals-card-chip--category">
                    <%= monthly_goal.category.name %>
                  </span>

                <% end %>

                <h5 class="roadmap-monthly-item__title">
                  <%= monthly_goal.title %>
                </h5>

              </div>

            </div>


            <div class="roadmap-weekly-area">

              <p class="roadmap-weekly-heading">
                <%= t(".weekly_goals_heading") %>
              </p>

              <% if monthly_goal.weekly_goals.empty? %>

                <p class="roadmap-weekly-empty">
                  <%= t(".no_weekly_goals") %>
                </p>

              <% else %>

                <div class="roadmap-weekly-list">

                  <% monthly_goal.weekly_goals
                                         .sort_by(&:week_number)
                                         .each do |weekly_goal| %>

                    <div class="roadmap-weekly-item">

                      <span class="roadmap-weekly-item__week">
                        <%= t(".week_number", number: weekly_goal.week_number) %>
                      </span>

                      <span class="roadmap-weekly-item__title">
                        <%= weekly_goal.title %>
                      </span>

                      <% if weekly_goal.week_number == @current_week_number %>

                        <span class="roadmap-weekly-item__current">
                          <%= t(".current_week") %>
                        </span>

                      <% end %>

                    </div>

                  <% end %>

                </div>

              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

</div>