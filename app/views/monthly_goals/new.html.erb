<% content_for :title, t(".page_title") %>

<main class="goal-new-page">

  <header class="goal-new-header">

    <%= link_to "←",
          monthly_goals_path,
          class: "goal-new-back",
          "aria-label": t(".back_aria") %>

    <h1 class="goal-new-heading">
      <%= t(".heading") %>
    </h1>

  </header>


  <section
    class="goal-new-card"
    aria-labelledby="goal-new-card-label"
  >

    <p
      id="goal-new-card-label"
      class="goal-new-card-label"
    >
      <%= @target_month_param == "next" ?
            t(".target_period.next") :
            t(".target_period.current") %>
    </p>


    <p class="goal-new-target-month">
      <%= t(
            ".target_month",
            month: l(@target_month_date, format: :year_month)
          ) %>
    </p>


    <% if @monthly_goal.errors.any? %>

      <div class="goal-new-error" role="alert">

        <p class="goal-new-error-title">
          <%= t(
                ".errors.title",
                count: @monthly_goal.errors.count
              ) %>
        </p>

        <ul class="goal-new-error-list">

          <% @monthly_goal.errors.full_messages.each do |message| %>

            <li>
              <%= message %>
            </li>

          <% end %>

        </ul>

      </div>

    <% end %>


    <%= form_with model: @monthly_goal,
                  url: monthly_goals_path(target_month: @target_month_param),
                  local: true,
                  class: "goal-new-form" do |f| %>


      <%# ==================================================
          目標内容
      =================================================== %>

      <div class="goal-new-form-group">

        <%= f.label :title,
              t(".title.label"),
              class: "goal-new-form-label" %>

        <%= f.text_field :title,
              class: "goal-new-form-input",
              placeholder: t(".title.placeholder") %>

      </div>


      <%# ==================================================
          カテゴリー
      =================================================== %>

      <div class="goal-new-form-group">

        <span class="goal-new-form-label">
          <%= t(".category.label") %>
        </span>

        <div
          class="goal-new-chips"
          role="radiogroup"
          aria-label="<%= t(".category.aria_label") %>"
        >

          <% @categories.each do |category| %>

            <label class="goal-new-chip">

              <%= f.radio_button :category_id,
                    category.id,
                    class: "goal-new-chip-input" %>

              <span class="goal-new-chip-label">
                <%= category.name %>
              </span>

            </label>

          <% end %>

        </div>

      </div>


      <%# ==================================================
          目標タイプ
      =================================================== %>

      <div class="goal-new-form-group">

        <span class="goal-new-form-label">
          <%= t(".goal_kind.label") %>
        </span>

        <div
          class="goal-new-chips"
          role="radiogroup"
          aria-label="<%= t(".goal_kind.aria_label") %>"
        >

          <label class="goal-new-chip">

            <%= f.radio_button :goal_kind,
                  "step",
                  class: "goal-new-chip-input" %>

            <span class="goal-new-chip-label">
              <%= t(".goal_kind.step") %>
            </span>

          </label>


          <label class="goal-new-chip">

            <%= f.radio_button :goal_kind,
                  "single",
                  class: "goal-new-chip-input" %>

            <span class="goal-new-chip-label">
              <%= t(".goal_kind.single") %>
            </span>

          </label>

        </div>


        <p class="goal-new-form-hint">

          <%= t(".goal_kind.step_hint") %>
          <br>

          <%= t(".goal_kind.single_hint") %>

        </p>

      </div>


      <%= f.submit t(".submit"),
            class: "goal-new-submit" %>

    <% end %>

  </section>

</main>