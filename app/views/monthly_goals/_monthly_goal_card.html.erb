<%# 月目標カード（ロードマップ配下・ロードマップなし の両方で共用） %>

<article class="mypage-card">

  <header class="goals-card-header">

    <p class="goals-card-month">
      <%= l(goal.target_month, format: :year_month) %>
    </p>

    <div class="goals-card-actions">

      <%= link_to t("common.edit"),
            edit_monthly_goal_path(goal),
            class: "goals-card-action-btn",
            aria: {
              label: t(
                "monthly_goals_card.actions.edit_aria",
                title: goal.title
              )
            } %>

      <%= button_to t("common.delete"),
            monthly_goal_path(goal),
            method: :delete,
            form: {
              class: "goals-card-action-form",
              data: {
                turbo_confirm: t(
                  "monthly_goals_card.actions.delete_confirm",
                  title: goal.title
                )
              }
            },
            class: "goals-card-action-btn goals-card-action-btn--danger",
            aria: {
              label: t(
                "monthly_goals_card.actions.delete_aria",
                title: goal.title
              )
            } %>

    </div>

  </header>


  <h2 class="goals-card-title">
    <%= goal.title %>
  </h2>


  <div class="goals-card-meta">

    <span class="goals-card-chip goals-card-chip--category">
      <%= goal.category.name %>
    </span>

    <span class="goals-card-chip goals-card-chip--kind">
      <%= goal.step? ?
            t("monthly_goals_card.kind.step") :
            t("monthly_goals_card.kind.single") %>
    </span>

  </div>


  <%# 週目標表示エリア %>

  <section
    class="weekly-goals"
    aria-label="<%= t('monthly_goals_card.weekly.heading') %>">

    <h3 class="weekly-goals-heading">
      <%= t("monthly_goals_card.weekly.heading") %>
    </h3>


    <% sorted_weekly_goals =
         goal.weekly_goals.to_a.sort_by { |w| [w.week_number, w.start_date] } %>

    <% is_current_month_card =
         goal.target_month == @current_month_date %>


    <% if sorted_weekly_goals.empty? %>

      <p class="weekly-goals-empty">
        <%= t("monthly_goals_card.weekly.empty") %>
      </p>

    <% else %>

      <ol class="weekly-goals-list">

        <% sorted_weekly_goals.each do |wg| %>

          <% is_current_week =
               is_current_month_card &&
               wg.week_number == @current_week_number %>

          <li
            class="weekly-goal-item <%= 'weekly-goal-item--current' if is_current_week %>"
            <%= 'aria-current="true"'.html_safe if is_current_week %>>

            <span class="weekly-goal-week">

              <span class="weekly-goal-week-label">
                <%= t(
                  "monthly_goals_card.weekly.week",
                  number: wg.week_number
                  ) %>
              </span>

              <span class="weekly-goal-week-number">
                <%= wg.week_number %>
              </span>

            </span>


            <div class="weekly-goal-body">

              <span class="weekly-goal-title">
                <%= wg.title %>
              </span>

              <span class="weekly-goal-date">
                <%= t(
                      "monthly_goals_card.weekly.date_from",
                      date: l(wg.start_date, format: :month_day)
                    ) %>
              </span>

            </div>


            <div class="weekly-goal-actions">

              <%= link_to t("common.edit"),
                    edit_monthly_goal_weekly_goal_path(goal, wg),
                    class: "weekly-goal-action-btn",
                    aria: {
                      label: t(
                        "monthly_goals_card.weekly.edit_aria",
                        week_number: wg.week_number,
                        title: wg.title
                      )
                    } %>


              <%= button_to t("common.delete"),
                    monthly_goal_weekly_goal_path(goal, wg),
                    method: :delete,
                    form: {
                      class: "weekly-goal-action-form",
                      data: {
                        turbo_confirm: t(
                          "monthly_goals_card.weekly.delete_confirm",
                          week_number: wg.week_number,
                          title: wg.title
                        )
                      }
                    },
                    class: "weekly-goal-action-btn weekly-goal-action-btn--danger",
                    aria: {
                      label: t(
                        "monthly_goals_card.weekly.delete_aria",
                        week_number: wg.week_number,
                        title: wg.title
                      )
                    } %>

            </div>

          </li>

        <% end %>

      </ol>

    <% end %>


    <%# 来月の月目標、かつ25日以前は週目標追加ボタンを出さない %>

    <% is_next_month_card =
         goal.target_month == Date.current.next_month.beginning_of_month %>

    <% can_add_weekly_goal =
         !is_next_month_card || @next_month_available %>


    <% if can_add_weekly_goal %>

      <%= link_to t("monthly_goals_card.weekly.add"),
            new_monthly_goal_weekly_goal_path(goal),
            class: "weekly-goals-add-btn" %>

    <% end %>

  </section>

</article>