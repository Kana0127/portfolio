<% content_for :title, t(".page_title") %>

<main class="reviews-page">

  <header class="reviews-header">

    <%= link_to "←",
          reviews_path,
          class: "reviews-back",
          "aria-label": t(".back_aria") %>

    <h1 class="reviews-heading">
      <%= t(".heading") %>
    </h1>

  </header>


  <% if @monthly_review.errors.any? %>

    <div class="reviews-error" role="alert">

      <p class="reviews-error-title">
        <%= t(
              ".errors.title",
              count: @monthly_review.errors.count
            ) %>
      </p>

      <ul class="reviews-error-list">

        <% @monthly_review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>


  <%# ==================================================
      カード1：今月の目標
  =================================================== %>

  <section class="reviews-card reviews-card--target">

    <p class="reviews-card-label">
      <%= t(".target.label") %>
    </p>

    <p class="reviews-card-title">
      <%= @monthly_goal.title %>
    </p>

    <p class="reviews-card-meta">
      <%= l(@monthly_goal.target_month, format: :year_month) %>
    </p>

  </section>


  <%= form_with model: @monthly_review,
                url: monthly_goal_monthly_review_path(@monthly_goal),
                local: true do |f| %>


    <%# ==================================================
        カード2：達成度
    =================================================== %>

    <section
      class="reviews-card reviews-card--rate"
      aria-labelledby="monthly-rate-heading"
    >

      <p
        id="monthly-rate-heading"
        class="reviews-card-label"
      >
        <%= t(".achievement.label") %>
      </p>

      <p class="reviews-card-sub">
        <%= t(".achievement.lead") %>
      </p>


      <% achievement_options = [
        [100, "◎", :excellent],
        [75,  "○", :done],
        [50,  "△", :almost],
        [25,  "·", :next],
        [0,   "×", :starting]
      ] %>


      <div
        class="reviews-rates"
        role="radiogroup"
        aria-labelledby="monthly-rate-heading"
      >

        <% achievement_options.each do |val, sym, key| %>

          <label class="reviews-rate">

            <%= f.radio_button :achievement_rate,
                  val,
                  class: "reviews-rate-input" %>

            <span class="reviews-rate-card">

              <span class="reviews-rate-symbol">
                <%= sym %>
              </span>

              <span class="reviews-rate-label">
                <%= t(".achievement.options.#{key}") %>
              </span>

              <span class="reviews-rate-value">
                <%= val %>%
              </span>

            </span>

          </label>

        <% end %>

      </div>

    </section>


    <%# ==================================================
        カード3：振り返りコメント
    =================================================== %>

    <section class="reviews-card reviews-card--comment">

      <p class="reviews-card-label">
        <%= t(".comment.label") %>
      </p>

      <p class="reviews-card-sub">
        <%= t(".comment.lead") %>
      </p>


      <div class="reviews-form-group">

        <%= f.label :good_point,
              t(".comment.good_point.label"),
              class: "reviews-form-label" %>

        <%= f.text_area :good_point,
              class: "reviews-form-input",
              rows: 3,
              placeholder: t(".comment.good_point.placeholder") %>

      </div>


      <div class="reviews-form-group">

        <%= f.label :improvement_point,
              t(".comment.improvement_point.label"),
              class: "reviews-form-label" %>

        <%= f.text_area :improvement_point,
              class: "reviews-form-input",
              rows: 3,
              placeholder: t(".comment.improvement_point.placeholder") %>

      </div>


      <div class="reviews-form-group">

        <%= f.label :memo,
              t(".comment.memo.label"),
              class: "reviews-form-label" %>

        <%= f.text_area :memo,
              class: "reviews-form-input",
              rows: 3,
              placeholder: t(".comment.memo.placeholder") %>

      </div>

    </section>


    <%= f.submit t(".submit"),
          class: "reviews-btn reviews-btn--primary reviews-btn--full" %>

  <% end %>


  <p class="reviews-back-link">

    <%= link_to t(".back_to_reviews"),
          reviews_path,
          class: "reviews-btn reviews-btn--secondary reviews-btn--full" %>

  </p>

</main>