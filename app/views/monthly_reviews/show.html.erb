<% content_for :title, t(".page_title") %>

<main class="reviews-page">

  <header class="reviews-header">

    <%= link_to "←",
          reviews_path,
          class: "reviews-back",
          "aria-label": t(".back_aria") %>

    <h1 class="reviews-heading">
      <%= t(".heading") %>
    </h1>

  </header>


  <%# ==============================
      対象の月目標
  ============================== %>

  <section class="reviews-card reviews-card--target">

    <p class="reviews-card-label">
      <%= t(".target.label") %>
    </p>

    <p class="reviews-card-title">
      <%= @monthly_goal.title %>
    </p>

    <p class="reviews-card-meta">
      <%= l(@monthly_goal.target_month, format: :year_month) %>
    </p>

  </section>


  <%# ==============================
      達成率
  ============================== %>

  <section class="reviews-card">

    <p class="reviews-card-label">
      <%= t(".achievement_rate.label") %>
    </p>

    <p class="reviews-show-rate">
      <%= @monthly_review.achievement_rate %>
      <span class="reviews-show-rate-percent">%</span>
    </p>

  </section>


  <%# ==============================
      今月の自分への一言
  ============================== %>

  <section class="reviews-card">

    <p class="reviews-card-label">
      <%= t(".good_point.label") %>
    </p>

    <div class="reviews-show-text">
      <%= simple_format(@monthly_review.good_point) %>
    </div>

  </section>


  <%# ==============================
      来月の自分への一言
  ============================== %>

  <section class="reviews-card">

    <p class="reviews-card-label">
      <%= t(".improvement_point.label") %>
    </p>

    <div class="reviews-show-text">
      <%= simple_format(@monthly_review.improvement_point) %>
    </div>

  </section>


  <%# ==============================
      メモ
  ============================== %>

  <section class="reviews-card">

    <p class="reviews-card-label">
      <%= t(".memo.label") %>
    </p>

    <% if @monthly_review.memo.present? %>

      <div class="reviews-show-text">
        <%= simple_format(@monthly_review.memo) %>
      </div>

    <% else %>

      <p class="reviews-show-text reviews-show-text--empty">
        <%= t(".memo.empty") %>
      </p>

    <% end %>

  </section>


  <p class="reviews-back-link">

    <%= link_to t(".back_to_reviews"),
          reviews_path,
          class: "reviews-btn reviews-btn--secondary reviews-btn--full" %>

  </p>

</main>