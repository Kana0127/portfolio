<% content_for :title, t(".page_title") %>

<main class="reviews-page">

  <header class="reviews-header reviews-header--stacked">

    <h1 class="reviews-heading">
      <%= t(".heading") %>
    </h1>

    <p class="reviews-tagline">
      <%= t(".tagline") %>
    </p>

  </header>


  <%# ==================================================
      タブ切替
  =================================================== %>

  <input
    type="radio"
    id="reviews-tab-weekly"
    name="reviews-tab"
    class="reviews-tab-input"
    checked
  >

  <input
    type="radio"
    id="reviews-tab-monthly"
    name="reviews-tab"
    class="reviews-tab-input"
  >


  <div class="reviews-tab-buttons" role="tablist">

    <label
      for="reviews-tab-weekly"
      class="reviews-tab-label reviews-tab-label--weekly"
    >
      <%= t(".tabs.weekly") %>
    </label>

    <label
      for="reviews-tab-monthly"
      class="reviews-tab-label reviews-tab-label--monthly"
    >
      <%= t(".tabs.monthly") %>
    </label>

  </div>


  <%# ==================================================
      週次タブ
  =================================================== %>

  <div class="reviews-tab-content reviews-tab-content--weekly">


    <%# ------------------------------
        先週のふりかえり
    ------------------------------ %>

    <% if @last_weekly_goals.any? %>

      <section
        class="reviews-section"
        aria-labelledby="reviews-last-heading"
      >

        <h2
          id="reviews-last-heading"
          class="reviews-section-heading"
        >
          <%= t(".weekly.last.heading") %>
        </h2>


        <% @last_weekly_goals.each do |wg| %>

          <% review = wg.weekly_review %>

          <article class="reviews-card">

            <div class="reviews-card-icon" aria-hidden="true">
              📅
            </div>

            <div class="reviews-card-body">

              <p class="reviews-card-meta">

                <%= t(
                      ".weekly.meta",
                      month: l(
                        wg.monthly_goal.target_month,
                        format: :year_month
                      ),
                      week_number: wg.week_number
                    ) %>

              </p>


              <p class="reviews-card-title">
                <%= wg.title %>
              </p>


              <% if review %>

                <dl class="reviews-card-summary">

                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".weekly.summary.achievement_rate") %>
                    </dt>

                    <dd>
                      <strong>
                        <%= review.achievement_rate %>%
                      </strong>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".weekly.summary.good_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.good_point, length: 40) %>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".weekly.summary.improvement_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.improvement_point, length: 40) %>
                    </dd>

                  </div>

                </dl>


                <%= link_to t(".actions.show_review"),
                      weekly_goal_weekly_review_path(wg),
                      class: "reviews-btn reviews-btn--secondary" %>


              <% else %>

                <p class="reviews-card-text">
                  <%= t(".weekly.last.prompt") %>
                </p>

                <%= link_to t(".actions.create_review"),
                      new_weekly_goal_weekly_review_path(wg),
                      class: "reviews-btn reviews-btn--primary" %>

              <% end %>

            </div>

          </article>

        <% end %>

      </section>

    <% end %>


    <%# ------------------------------
        今週のふりかえり
    ------------------------------ %>

    <section
      class="reviews-section"
      aria-labelledby="reviews-weekly-heading"
    >

      <h2
        id="reviews-weekly-heading"
        class="reviews-section-heading"
      >
        <%= t(".weekly.current.heading") %>
      </h2>


      <% if @current_weekly_goals.empty? %>

        <article class="reviews-card reviews-card--empty">

          <div class="reviews-card-icon" aria-hidden="true">
            🎯
          </div>

          <p class="reviews-card-text">
            <%= t(".weekly.current.no_goal") %>
          </p>

          <%= link_to t(".actions.goals"),
                monthly_goals_path,
                class: "reviews-btn reviews-btn--primary" %>

        </article>


      <% else %>

        <% @current_weekly_goals.each do |wg| %>

          <% review = wg.weekly_review %>

          <article class="reviews-card">

            <div class="reviews-card-icon" aria-hidden="true">
              📝
            </div>

            <div class="reviews-card-body">

              <p class="reviews-card-meta">

                <%= t(
                      ".weekly.meta",
                      month: l(
                        wg.monthly_goal.target_month,
                        format: :year_month
                      ),
                      week_number: wg.week_number
                    ) %>

              </p>


              <p class="reviews-card-title">
                <%= wg.title %>
              </p>


              <% if review %>

                <dl class="reviews-card-summary">

                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".weekly.summary.achievement_rate") %>
                    </dt>

                    <dd>
                      <strong>
                        <%= review.achievement_rate %>%
                      </strong>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".weekly.summary.good_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.good_point, length: 40) %>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".weekly.summary.improvement_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.improvement_point, length: 40) %>
                    </dd>

                  </div>

                </dl>


                <%= link_to t(".actions.show_review"),
                      weekly_goal_weekly_review_path(wg),
                      class: "reviews-btn reviews-btn--secondary" %>


              <% elsif @encourage_current_review %>

                <p class="reviews-card-text">
                  <%= t(".weekly.current.prompt") %>
                </p>

                <%= link_to t(".actions.create_review"),
                      new_weekly_goal_weekly_review_path(wg),
                      class: "reviews-btn reviews-btn--primary" %>


              <% else %>

                <p class="reviews-card-text">

                  <%= t(".weekly.current.in_progress") %>

                  <br>

                  <span class="reviews-card-text-sub">
                    <%= t(".weekly.current.available_from") %>
                  </span>

                </p>

              <% end %>

            </div>

          </article>

        <% end %>

      <% end %>

    </section>

  </div>


  <%# ==================================================
      月次タブ
  =================================================== %>

  <div class="reviews-tab-content reviews-tab-content--monthly">


    <%# ------------------------------
        先月のふりかえり
    ------------------------------ %>

    <% if @last_monthly_goals.any? %>

      <section
        class="reviews-section"
        aria-labelledby="reviews-last-monthly-heading"
      >

        <h2
          id="reviews-last-monthly-heading"
          class="reviews-section-heading"
        >
          <%= t(".monthly.last.heading") %>
        </h2>


        <% @last_monthly_goals.each do |mg| %>

          <% review = mg.monthly_review %>

          <article class="reviews-card">

            <div class="reviews-card-icon" aria-hidden="true">
              📆
            </div>

            <div class="reviews-card-body">

              <p class="reviews-card-meta">
                <%= l(mg.target_month, format: :year_month) %>
              </p>

              <p class="reviews-card-title">
                <%= mg.title %>
              </p>


              <% if review %>

                <dl class="reviews-card-summary">

                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".monthly.summary.achievement_rate") %>
                    </dt>

                    <dd>
                      <strong>
                        <%= review.achievement_rate %>%
                      </strong>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".monthly.summary.good_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.good_point, length: 40) %>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".monthly.summary.improvement_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.improvement_point, length: 40) %>
                    </dd>

                  </div>

                </dl>


                <%= link_to t(".actions.show_review"),
                      monthly_goal_monthly_review_path(mg),
                      class: "reviews-btn reviews-btn--secondary" %>


              <% else %>

                <p class="reviews-card-text">
                  <%= t(".monthly.last.prompt") %>
                </p>

                <%= link_to t(".actions.create_review"),
                      new_monthly_goal_monthly_review_path(mg),
                      class: "reviews-btn reviews-btn--primary" %>

              <% end %>

            </div>

          </article>

        <% end %>

      </section>

    <% end %>


    <%# ------------------------------
        今月のふりかえり
    ------------------------------ %>

    <section
      class="reviews-section"
      aria-labelledby="reviews-monthly-heading"
    >

      <h2
        id="reviews-monthly-heading"
        class="reviews-section-heading"
      >
        <%= t(".monthly.current.heading") %>
      </h2>


      <% if @current_monthly_goals.empty? %>

        <article class="reviews-card reviews-card--empty">

          <div class="reviews-card-icon" aria-hidden="true">
            🌙
          </div>

          <p class="reviews-card-text">
            <%= t(".monthly.current.no_goal") %>
          </p>

          <%= link_to t(".actions.goals"),
                monthly_goals_path,
                class: "reviews-btn reviews-btn--primary" %>

        </article>


      <% else %>

        <% @current_monthly_goals.each do |mg| %>

          <% review = mg.monthly_review %>

          <article class="reviews-card">

            <div class="reviews-card-icon" aria-hidden="true">
              🌙
            </div>

            <div class="reviews-card-body">

              <p class="reviews-card-meta">
                <%= l(mg.target_month, format: :year_month) %>
              </p>

              <p class="reviews-card-title">
                <%= mg.title %>
              </p>


              <% if review %>

                <dl class="reviews-card-summary">

                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".monthly.summary.achievement_rate") %>
                    </dt>

                    <dd>
                      <strong>
                        <%= review.achievement_rate %>%
                      </strong>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".monthly.summary.good_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.good_point, length: 40) %>
                    </dd>

                  </div>


                  <div class="reviews-card-summary-item">

                    <dt>
                      <%= t(".monthly.summary.improvement_point") %>
                    </dt>

                    <dd>
                      <%= truncate(review.improvement_point, length: 40) %>
                    </dd>

                  </div>

                </dl>


                <%= link_to t(".actions.show_review"),
                      monthly_goal_monthly_review_path(mg),
                      class: "reviews-btn reviews-btn--secondary" %>


              <% elsif @encourage_current_month_review %>

                <p class="reviews-card-text">
                  <%= t(".monthly.current.prompt") %>
                </p>

                <%= link_to t(".actions.create_review"),
                      new_monthly_goal_monthly_review_path(mg),
                      class: "reviews-btn reviews-btn--primary" %>


              <% else %>

                <p class="reviews-card-text">

                  <%= t(".monthly.current.available_from") %>

                </p>

              <% end %>

            </div>

          </article>

        <% end %>

      <% end %>

    </section>

  </div>


  <%# ==================================================
      過去のふりかえり
  =================================================== %>

  <section class="reviews-section">

    <%= link_to t(".actions.archive"),
          reviews_archive_path,
          class: "reviews-past-btn" %>

  </section>

</main>