<% content_for :title, t(".page_title") %>

<main class="goal-new-page">
  <header class="goal-new-header">
    <%= link_to "←", monthly_goals_path, class: "goal-new-back", "aria-label": t(".back_aria") %>
    <h1 class="goal-new-heading"><%= t(".heading") %></h1>
  </header>

  <section class="goal-new-card" aria-labelledby="weekly-edit-card-label">
    <p id="weekly-edit-card-label" class="goal-new-card-label">
      <%= t("weekly_goals.form.monthly_goal_label") %>
    </p>
    <p class="goal-new-target-month">
      <%= t("weekly_goals.form.target_month",
            month: l(@monthly_goal.target_month, format: :year_month),
            title: @monthly_goal.title) %>
    </p>
    <p class="goal-new-target-month">
      <%= t(".current_week_number") %><strong><%= t(".week_number", number: @weekly_goal.week_number) %></strong>
    </p>

    <% if @weekly_goal.errors.any? %>
      <div class="goal-new-error" role="alert">
        <p class="goal-new-error-title"><%= t("common.errors.title", count: @weekly_goal.errors.count) %></p>
        <ul class="goal-new-error-list">
          <% @weekly_goal.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# form_with model: [@monthly_goal, @weekly_goal] は永続化済みなので
        自動で PATCH /monthly_goals/:monthly_goal_id/weekly_goals/:id に送信される %>
    <%= form_with model: [@monthly_goal, @weekly_goal], local: true, class: "goal-new-form" do |f| %>
      <div class="goal-new-form-group">
        <%= f.label :title, t("weekly_goals.form.title.label"), class: "goal-new-form-label" %>
        <%= f.text_field :title,
              class: "goal-new-form-input",
              placeholder: t("weekly_goals.form.title.placeholder") %>
      </div>

      <div class="goal-new-form-group">
        <%= f.label :start_date, t("weekly_goals.form.start_date.label"), class: "goal-new-form-label" %>
        <%= f.select :start_date,
              @start_date_options,
              { include_blank: t("weekly_goals.form.start_date.include_blank") },
              class: "goal-new-form-input goal-new-form-select" %>
        <p class="goal-new-form-hint">
          <%= t(".hint_line1") %><br>
          <%= t(".hint_line2") %>
        </p>
      </div>

      <%= f.submit t(".submit"), class: "goal-new-submit" %>
    <% end %>
  </section>
</main>
