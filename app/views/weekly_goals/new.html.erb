<% content_for :title, t(".page_title") %>

<main class="goal-new-page ms-container">
  <header class="goal-new-header">
    <%= link_to "←",
          monthly_goals_path,
          class: "goal-new-back",
          aria: { label: t(".back_aria") } %>

    <h1 class="goal-new-heading">
      <%= t(".heading") %>
    </h1>
  </header>


  <%# ================================
      対象月・親目標の表示
  ================================= %>

  <section class="goal-new-summary">

    <% if @monthly_goal.present? %>

      <%# MonthlyGoal経由のWeeklyGoal %>

      <p class="goal-new-target-month">
        <%= t(
              "weekly_goals.form.target_month",
              month: l(@target_month, format: :year_month),
              title: @monthly_goal.title
            ) %>
      </p>

    <% else %>

      <%# Standalone WeeklyGoal %>

      <p class="goal-new-target-month">
        <%= t(
              "weekly_goals.form.standalone_target_month",
              month: l(@target_month, format: :year_month)
            ) %>
      </p>

    <% end %>

  </section>


  <%# ================================
      WeeklyGoalフォーム
  ================================= %>

  <%
    form_model =
      if @monthly_goal
        [@monthly_goal, @weekly_goal]
      else
        @weekly_goal
      end
  %>

  <%= form_with model: form_model,
                local: true,
                class: "ms-form" do |f| %>


    <%# ================================
        Validation errors
    ================================= %>

    <% if @weekly_goal.errors.any? %>
      <div class="ms-form-errors">
        <p>
          <%= t(
                ".errors.title",
                count: @weekly_goal.errors.count
              ) %>
        </p>

        <ul>
          <% @weekly_goal.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>


    <%# ================================
        タイトル
    ================================= %>

    <div class="ms-form-group">
      <%= f.label :title,
            t(".title.label"),
            class: "ms-form-label" %>

      <%= f.text_field :title,
            class: "ms-form-input",
            placeholder: t(".title.placeholder") %>
    </div>


    <%# ================================
        カテゴリー
    ================================= %>

    <% if @monthly_goal.present? %>

      <%# MonthlyGoal経由では親から引き継ぐ %>

      <div class="ms-form-group">
        <span class="ms-form-label">
          <%= t(".category.label") %>
        </span>

        <p class="ms-form-static">
          <%= @monthly_goal.category.name %>
        </p>
      </div>

    <% else %>

      <%# Standaloneではユーザーが選択 %>

      <div class="goal-new-form-group">

        <span class="goal-new-form-label">
          <%= t(".category.label") %>
        </span>

        <div
          class="goal-new-chips"
          role="radiogroup"
          aria-label="<%= t(".category.aria_label") %>"
        >

          <% @categories.each do |category| %>

            <label class="goal-new-chip">

              <%= f.radio_button :category_id,
                    category.id,
                    class: "goal-new-chip-input" %>

              <span class="goal-new-chip-label">
                <%= category.name %>
              </span>    
            </label>
          <% end %>  
        </div>
      </div>
    <% end %>

    <%# ================================
        週
    ================================= %>

    <div class="ms-form-group">
      <%= f.label :start_date,
            t(".start_date.label"),
            class: "ms-form-label" %>

      <%= f.select(
            :start_date,
            options_for_select(
              @start_date_options,
              @weekly_goal.start_date&.to_s
            ),
            { prompt: t(".start_date.prompt") },
            { class: "goal-new-form-input" }
          ) %>
    </div>


    <%# ================================
        Submit
    ================================= %>

    <div class="ms-form-actions">
      <%= f.submit t(".submit"),
            class: "btn-primary" %>
    </div>

  <% end %>
</main>