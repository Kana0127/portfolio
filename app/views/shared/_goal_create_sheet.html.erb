<div
  class="bottom-sheet"
  data-bottom-sheet-target="sheet"
  data-action="click->bottom-sheet#closeFromOverlay">

  <div
    class="bottom-sheet-panel"
    role="dialog"
    aria-modal="true"
    aria-label="<%= t('monthly_goals.index.create_dialog_label') %>">

    <span class="bottom-sheet-handle" aria-hidden="true"></span>

    <h2 class="bottom-sheet-title">
      <%= t("monthly_goals.index.create_prompt") %>
    </h2>

    <%# ロードマップ目標 %>
    <%= link_to new_roadmap_goal_path,
          class: "bottom-sheet-option bottom-sheet-option--roadmap" do %>

      <span class="bottom-sheet-option-icon">📖</span>

      <span class="bottom-sheet-option-body">
        <span class="bottom-sheet-option-title">
          <%= t("monthly_goals.index.roadmap.create_title") %>
        </span>
        <span class="bottom-sheet-option-desc">
          <%= t("monthly_goals.index.roadmap.description") %>
        </span>
      </span>

      <span class="bottom-sheet-option-arrow">→</span>
    <% end %>

    <%# 月目標 %>
    <%= link_to new_monthly_goal_path,
          class: "bottom-sheet-option" do %>

      <span class="bottom-sheet-option-icon">📅</span>

      <span class="bottom-sheet-option-body">
        <span class="bottom-sheet-option-title">
          <%= t("monthly_goals.index.monthly.create_title") %>
        </span>
        <span class="bottom-sheet-option-desc">
          <%= t("monthly_goals.index.monthly.description") %>
        </span>
      </span>

      <span class="bottom-sheet-option-arrow">→</span>
    <% end %>

    <%# 週目標 %>
    <%= link_to new_weekly_goal_path,
          class: "bottom-sheet-option" do %>

      <span class="bottom-sheet-option-icon">📝</span>

      <span class="bottom-sheet-option-body">
        <span class="bottom-sheet-option-title">
          <%= t("monthly_goals.index.weekly.create_title") %>
        </span>
        <span class="bottom-sheet-option-desc">
          <%= t("monthly_goals.index.weekly.description") %>
        </span>
      </span>

      <span class="bottom-sheet-option-arrow">→</span>
    <% end %>

    <button
      type="button"
      class="bottom-sheet-cancel"
      data-action="bottom-sheet#close">
      <%= t("common.cancel") %>
    </button>

  </div>
</div>