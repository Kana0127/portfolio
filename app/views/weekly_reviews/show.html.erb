<% content_for :title, t(".page_title") %>

<main class="reviews-page">
  <header class="reviews-header">
    <%= link_to "←", reviews_path, class: "reviews-back", "aria-label": t(".back_aria") %>
    <h1 class="reviews-heading"><%= t(".heading") %></h1>
  </header>

  <%# 対象の週目標 %>
  <section class="reviews-card reviews-card--target">
    <p class="reviews-card-label"><%= t(".target.label") %></p>
    <p class="reviews-card-title"><%= @weekly_goal.title %></p>
    <p class="reviews-card-meta">
      <%= t(".target.meta",
            month: l(@weekly_goal.monthly_goal.target_month, format: :year_month),
            week_number: @weekly_goal.week_number) %>
    </p>
  </section>

  <%# 達成率 %>
  <section class="reviews-card">
    <p class="reviews-card-label"><%= t(".achievement_rate.label") %></p>
    <p class="reviews-show-rate"><%= @weekly_review.achievement_rate %><span class="reviews-show-rate-percent">%</span></p>
  </section>

  <%# 良かった点 %>
  <section class="reviews-card">
    <p class="reviews-card-label"><%= t(".good_point.label") %></p>
    <p class="reviews-show-text"><%= simple_format(@weekly_review.good_point) %></p>
  </section>

  <%# 改善点 %>
  <section class="reviews-card">
    <p class="reviews-card-label"><%= t(".improvement_point.label") %></p>
    <p class="reviews-show-text"><%= simple_format(@weekly_review.improvement_point) %></p>
  </section>

  <%# メモ %>
  <section class="reviews-card">
    <p class="reviews-card-label"><%= t(".memo.label") %></p>
    <% if @weekly_review.memo.present? %>
      <p class="reviews-show-text"><%= simple_format(@weekly_review.memo) %></p>
    <% else %>
      <p class="reviews-show-text reviews-show-text--empty"><%= t("common.memo_empty") %></p>
    <% end %>
  </section>

  <p class="reviews-back-link">
    <%= link_to t(".back_to_reviews"), reviews_path, class: "reviews-btn reviews-btn--secondary reviews-btn--full" %>
  </p>
</main>
