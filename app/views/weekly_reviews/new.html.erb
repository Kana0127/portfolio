<% content_for :title, t(".page_title") %>

<main class="reviews-page">
  <header class="reviews-header">
    <%= link_to "←", reviews_path, class: "reviews-back", "aria-label": t(".back_aria") %>
    <h1 class="reviews-heading"><%= t(".heading") %></h1>
  </header>

  <% if @weekly_review.errors.any? %>
    <div class="reviews-error" role="alert">
      <p class="reviews-error-title"><%= t("common.errors.title", count: @weekly_review.errors.count) %></p>
      <ul class="reviews-error-list">
        <% @weekly_review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ============ カード1：今週の目標 ============ %>
  <section class="reviews-card reviews-card--target">
    <p class="reviews-card-label"><%= t(".target.label") %></p>
    <p class="reviews-card-title"><%= @weekly_goal.title %></p>
    <p class="reviews-card-meta">
      <%= t(".target.meta",
            month: l(@weekly_goal.monthly_goal.target_month, format: :year_month),
            week_number: @weekly_goal.week_number) %>
    </p>
  </section>

  <%= form_with model: @weekly_review,
              url: weekly_goal_weekly_review_path(@weekly_goal) do |f| %>
    <%# fieldset の min-inline-size:min-content とグリッドが干渉するため、
        section + role="radiogroup" の組み合わせに変更 %>
    <section class="reviews-card reviews-card--rate" aria-labelledby="reviews-rate-heading">
      <p id="reviews-rate-heading" class="reviews-card-label"><%= t(".achievement.label") %></p>
      <p class="reviews-card-sub"><%= t(".achievement.lead") %></p>
      <div class="reviews-rates" role="radiogroup" aria-labelledby="reviews-rate-heading">
        <% [
          [ 100, "◎", t(".achievement.options.excellent") ],
          [ 75,  "○", t(".achievement.options.done") ],
          [ 50,  "△", t(".achievement.options.almost") ],
          [ 25,  "·", t(".achievement.options.next") ],
          [ 0,   "×", t(".achievement.options.starting") ]
        ].each do |val, sym, label| %>
          <label class="reviews-rate">
            <%= f.radio_button :achievement_rate, val, class: "reviews-rate-input" %>
            <span class="reviews-rate-card">
              <span class="reviews-rate-symbol"><%= sym %></span>
              <span class="reviews-rate-label"><%= label %></span>
              <span class="reviews-rate-value"><%= val %>%</span>
            </span>
          </label>
        <% end %>
      </div>
    </section>

    <%# ============ カード3：振り返りコメント ============ %>
    <section class="reviews-card reviews-card--comment">
      <p class="reviews-card-label"><%= t(".comment.label") %></p>
      <p class="reviews-card-sub"><%= t(".comment.lead") %></p>

      <div class="reviews-form-group">
        <%= f.label :good_point, t(".comment.good_point.label"), class: "reviews-form-label" %>
        <%= f.text_area :good_point,
              class: "reviews-form-input",
              rows: 3,
              placeholder: t(".comment.good_point.placeholder") %>
      </div>

      <div class="reviews-form-group">
        <%= f.label :improvement_point, t(".comment.improvement_point.label"), class: "reviews-form-label" %>
        <%= f.text_area :improvement_point,
              class: "reviews-form-input",
              rows: 3,
              placeholder: t(".comment.improvement_point.placeholder") %>
      </div>

      <div class="reviews-form-group">
        <%= f.label :memo, t(".comment.memo.label"), class: "reviews-form-label" %>
        <%= f.text_area :memo,
              class: "reviews-form-input",
              rows: 3,
              placeholder: t(".comment.memo.placeholder") %>
      </div>
    </section>

    <%= f.submit t(".submit"), class: "reviews-btn reviews-btn--primary reviews-btn--full" %>
  <% end %>
</main>
